# Copiá este archivo como ".env" y completalo con tus valores reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

PORT=5000
NODE_ENV=development

# URL del frontend (en Vercel: https://<tu-proyecto>.vercel.app, sin barra final).
# CORS solo acepta pedidos desde esta dirección.
FRONTEND_URL=http://localhost:5173

# --- Gemini ---
# Clave de Google AI Studio (https://aistudio.google.com), plan gratuito,
# creada en el proyecto de Google Cloud del docente.
LLM_API_KEY=
# Modelo principal y de respaldo. Si al principal se le agota la cuota diaria,
# está saturado o deja de existir, el servidor pasa solo al de respaldo.
# Cada modelo tiene su propia cuota. Verificá nombres y límites en
# https://ai.google.dev/gemini-api/docs/models y https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
# Temperatura (dejala vacía para usar la del modelo)
GEMINI_TEMPERATURA=0.6
# Tope de la respuesta en tokens (incluye el razonamiento interno del modelo)
GEMINI_MAX_TOKENS_SALIDA=800
# Nivel de razonamiento: minimal, low, medium o high. Vacío = el del modelo
# (en gemini-3.5-flash-lite el valor por defecto es "minimal", el más económico).
GEMINI_NIVEL_RAZONAMIENTO=
# Topes propios, por debajo de los del plan gratuito (gemini-3.5-flash-lite:
# 15 pedidos por minuto y 500 por día, consultado en AI Studio el 01/11/2026).
# Por minuto: suma de todos los modelos. Por día: cada modelo por separado.
GEMINI_RPM_MAX=12
GEMINI_RPD_MAX=450
GEMINI_RPD_MAX_RESPALDO=450

# --- Límites del chat ---
MAX_CARACTERES_MENSAJE=2000
MAX_MENSAJES_HISTORIAL=20
# Por grupo (comisión + código + corpus)
MAX_MENSAJES_POR_MINUTO=6
MAX_MENSAJES_SESION=70
TOP_FRAGMENTOS=4
# Umbral de la interpretación inicial: habilita la fase 2 (bibliografía),
# el pedido de observaciones sobre las imágenes y luego la comparación
MIN_MENSAJES_ANTES_IMAGENES=2
MIN_CARACTERES_ANTES_IMAGENES=300

# --- Google Drive (bibliografía) ---
DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
DRIVE_RESYNC_MINUTOS=30
ADMIN_TOKEN=
